---
import { getDB, getCategoriesWithArticles } from '@/utils/d1';
import { CATEGORY_NAV } from '@/consts';

// Mesmo motivo do Header: os links fixos levavam a categorias vazias, em todas as
// páginas do site. Aqui faltava ainda 'tech-geral', que existia no menu do topo.
const db = getDB(Astro);
const comArtigos = db ? await getCategoriesWithArticles(db) : [];
const nav = CATEGORY_NAV.filter(c => comArtigos.includes(c.slug));
---

<footer class="bg-gray-900 text-gray-300 mt-16">
  <div class="container mx-auto py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-white font-bold text-lg mb-3">i-a-trend</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Blog sobre automação com inteligência artificial para negócios no Brasil.
          As tendências, ferramentas e casos de uso que você precisa conhecer.
        </p>
      </div>
      {nav.length > 0 && (
        <div>
          <h4 class="text-white font-semibold mb-3">Categorias</h4>
          <ul class="space-y-2 text-sm">
            {nav.map(c => (
              <li>
                <a href={`/categoria/${c.slug}`} class="hover:text-primary-400 transition-colors">{c.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div>
        <h4 class="text-white font-semibold mb-3">Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/sobre" class="hover:text-primary-400 transition-colors">Sobre</a></li>
          <li><a href="/contato" class="hover:text-primary-400 transition-colors">Contato</a></li>
          <li><a href="/privacidade" class="hover:text-primary-400 transition-colors">Política de Privacidade</a></li>
          <li><a href="/rss.xml" class="hover:text-primary-400 transition-colors">RSS Feed</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>&copy; {new Date().getFullYear()} i-a-trend. Todos os direitos reservados.</p>
      <p>Feito com 💙 para o ecossistema de IA brasileiro</p>
    </div>
  </div>
</footer>

<slot />