---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<Layout
  title="Fale Conosco"
  description="Entre em contato com a equipe do i-a-trend: sugestões de pauta, publicidade, parcerias e questões de privacidade."
  url="/contato"
>
  <Header slot="header" />

  <section class="container py-10 max-w-2xl">
    <h1 class="text-3xl font-bold text-gray-900">Fale Conosco</h1>
    <p class="mt-3 text-gray-600">
      Tem alguma dúvida, sugestão ou quer entrar em contato? Utilize o formulário abaixo.
    </p>

    <form class="space-y-5 mt-8" action="https://formsubmit.co/contato@i-a-trend.com" method="POST">
      <input type="hidden" name="_subject" value="Contato via i-a-trend" />
      <input type="hidden" name="_captcha" value="true" />
      <input type="text" name="_honey" style="display:none" />

      <div>
        <label for="nome" class="block text-sm font-medium text-gray-700 mb-1.5">Nome</label>
        <input
          type="text"
          id="nome"
          name="nome"
          required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
          placeholder="Seu nome"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">E-mail</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
          placeholder="seu@email.com"
        />
      </div>

      <div>
        <label for="assunto" class="block text-sm font-medium text-gray-700 mb-1.5">Assunto</label>
        <select
          id="assunto"
          name="assunto"
          required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
        >
          <option value="">Selecione...</option>
          <option value="publicidade">Publicidade / Anúncios</option>
          <option value="pauta">Sugestão de pauta</option>
          <option value="privacidade">Questão de privacidade</option>
          <option value="parceria">Parceria</option>
          <option value="outro">Outro</option>
        </select>
      </div>

      <div>
        <label for="mensagem" class="block text-sm font-medium text-gray-700 mb-1.5">Mensagem</label>
        <textarea
          id="mensagem"
          name="mensagem"
          rows="5"
          required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
          placeholder="Sua mensagem..."></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2.5 px-6 rounded-lg transition-colors text-sm"
      >
        Enviar Mensagem
      </button>
    </form>

    <div class="mt-10 pt-6 border-t border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Outras formas de contato</h2>
      <p class="mt-2 text-sm text-gray-600">
        Você também pode nos escrever diretamente para:
        <a href="mailto:contato@i-a-trend.com" class="text-primary-600 hover:underline">contato@i-a-trend.com</a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
