---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import NewsCard from '@/components/NewsCard.astro';
import { getAllArticles, getDB } from '@/utils/d1';

const db = getDB(Astro);
const recent = db ? (await getAllArticles(db)).slice(0, 3) : [];

Astro.response.status = 404;
Astro.response.statusText = 'Not Found';
---

<Layout
  title="Página não encontrada"
  description="A página que você procura não existe ou foi movida."
  url="/404"
>
  <Header slot="header" />

  <section class="container py-16 text-center">
    <p class="text-6xl font-bold text-gray-300">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-900">Página não encontrada</h1>
    <p class="mt-3 text-gray-600 max-w-lg mx-auto">
      O endereço que você acessou não existe ou o conteúdo foi movido.
      Confira as notícias mais recentes abaixo ou volte para a página inicial.
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 text-sm font-medium text-white bg-primary-600 hover:bg-primary-500 rounded-full transition-colors"
      >
        Ir para a home
      </a>
      <a
        href="/categoria/ia-automacao"
        class="px-5 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50 rounded-full transition-colors"
      >
        Ver IA &amp; Automação
      </a>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="container pb-16">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Publicações recentes</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recent.map(article => <NewsCard article={article as any} />)}
      </div>
    </section>
  )}

  <Footer slot="footer" />
</Layout>
